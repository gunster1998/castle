[Unit]
Description=Castle Fight 3D (новая версия, порт 8788)
After=network.target

[Service]
Type=simple
User=castlefight3d
Group=castlefight3d
WorkingDirectory=/opt/castlefight3d
ExecStart=/opt/castlefight3d/node/bin/node /opt/castlefight3d/server.cjs
Restart=always
RestartSec=5
Environment=PORT=8788
Environment=HOST=0.0.0.0
Environment=STATIC_DIR=/opt/castlefight3d/dist
Environment=NODE_ENV=production
Nice=10
MemoryMax=300M
CPUWeight=50
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/castlefight3d
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
